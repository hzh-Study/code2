# 数据库：默认 SQLite 开箱即跑；生产改为 MySQL
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/restaurant_db
DATABASE_URL=sqlite:///./restaurant.db

UPLOAD_DIR=uploads
STATIC_URL_PREFIX=/static

# 微信小程序
WX_APPID=
WX_SECRET=
WX_MCH_ID=
WX_API_KEY=
NOTIFY_URL=http://localhost:8000/api/v1/client/pay/notify

# token 有效期
TOKEN_EXPIRE_HOURS=72
ADMIN_TOKEN_EXPIRE_HOURS=24

# 订单超时（分钟）
ORDER_EXPIRE_MINUTES=15

# token 签名密钥（生产务必修改）
SECRET_KEY=change-me-please-use-strong-secret-in-prod

CORS_ORIGINS=*
